# =====================================================================
# AgroIA · variáveis de ambiente
# Copie para .env.local e preencha. NUNCA faça commit do .env.local.
# Variáveis com prefixo NEXT_PUBLIC_ vão para o navegador; todas as
# outras ficam apenas no servidor.
# =====================================================================

# --- Supabase (obrigatório) -------------------------------------------
# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon/publishable). Segura no navegador porque o banco usa RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: usada SOMENTE pelo script de ingestão da base de
# conhecimento (npm run kb:ingest). A aplicação web não precisa dela.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (links de e-mail de login)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Inteligência artificial (obrigatório para o chat) ------------------
# Provedor de IA. Hoje: "anthropic" (Claude). A camada src/lib/ai foi
# escrita para receber outros provedores no futuro.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modelo usado no chat e na análise de fotos
AI_MODEL=claude-opus-5-5
# Profundidade de raciocínio: low | medium | high | xhigh | max
AI_EFFORT=medium
# Reexecuta automaticamente no modelo recomendado se o modelo principal
# recusar uma solicitação por política de segurança (fallback do servidor).
AI_REFUSAL_FALLBACK=true
# Busca na web restrita a fontes oficiais (Embrapa, gov.br, universidades)
# para trazer referências. Precisa estar habilitada na organização do
# Console da Anthropic. Custo adicional por busca.
AI_WEB_SEARCH=true
AI_WEB_SEARCH_MAX_USES=3

# --- Base de conhecimento (RAG) -----------------------------------------
# Opcional: embeddings para busca semântica (Voyage AI). Sem esta chave a
# base de conhecimento usa busca textual em português no Postgres.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# --- Voz (opcional) -----------------------------------------------------
# Com ElevenLabs configurado, a transcrição e as respostas em áudio são
# feitas no servidor. Sem ela, o app usa os recursos de voz do próprio
# navegador quando disponíveis (Chrome/Android, Safari/iOS).
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ID de uma voz da sua conta ElevenLabs (obrigatório para áudio no servidor)
ELEVENLABS_VOICE_ID=

# --- Limites ------------------------------------------------------------
# Máximo de mensagens por usuário a cada 10 minutos
RATE_LIMIT_MESSAGES_PER_10_MIN=20

# --- WhatsApp (futuro; desligado por padrão) ----------------------------
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
