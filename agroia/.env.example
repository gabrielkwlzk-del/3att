# =====================================================================
# AgroIA · variáveis de ambiente
# Copie para .env.local e preencha. NUNCA faça commit do .env.local.
# Variáveis com prefixo NEXT_PUBLIC_ vão para o navegador; todas as
# outras ficam apenas no servidor.
# =====================================================================

# --- Supabase (obrigatório) -------------------------------------------
# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon/publishable). Segura no navegador porque o banco usa RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: usada pelo script de ingestão da base de conhecimento
# (npm run kb:ingest) e pelo webhook de pagamento. Nunca vai para o navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (links de e-mail de login)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Inteligência artificial (obrigatório para o chat) ------------------
# Provedor de IA. Hoje: "anthropic" (Claude). A camada src/lib/ai foi
# escrita para receber outros provedores no futuro.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modelo usado no chat e na análise de fotos
AI_MODEL=claude-opus-5-5
# Profundidade de raciocínio: low | medium | high | xhigh | max
AI_EFFORT=medium
# Modelo por plano (vazio = usa AI_MODEL). Foto usa AI_MODEL_VISION.
# Sugestão para a margem dos planos (veja docs/ASSINATURAS.md):
AI_MODEL_SEMENTE=claude-haiku-5-5
AI_MODEL_PRODUTOR=claude-sonnet-5-5
AI_MODEL_FAZENDA=claude-sonnet-5-5
AI_MODEL_VISION=claude-opus-5-5
# Reexecuta automaticamente no modelo recomendado se o modelo principal
# recusar uma solicitação por política de segurança (fallback do servidor).
AI_REFUSAL_FALLBACK=true
# Busca na web restrita a fontes oficiais (Embrapa, gov.br, universidades)
# para trazer referências. Precisa estar habilitada na organização do
# Console da Anthropic. Custo adicional por busca.
AI_WEB_SEARCH=true
AI_WEB_SEARCH_MAX_USES=3

# --- Base de conhecimento (RAG) -----------------------------------------
# Opcional: embeddings para busca semântica (Voyage AI). Sem esta chave a
# base de conhecimento usa busca textual em português no Postgres.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# --- Voz (opcional) -----------------------------------------------------
# Com ElevenLabs configurado, a transcrição e as respostas em áudio são
# feitas no servidor. Sem ela, o app usa os recursos de voz do próprio
# navegador quando disponíveis (Chrome/Android, Safari/iOS).
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ID de uma voz da sua conta ElevenLabs (obrigatório para áudio no servidor)
ELEVENLABS_VOICE_ID=

# --- Assinaturas (Cakto) ------------------------------------------------
# Desligado por padrão: com false, ninguém é limitado e a página /plano avisa
# que as assinaturas ainda não estão ativas. Só mude para true depois de rodar
# a migração 20261113000000_billing.sql. Passo a passo: docs/ASSINATURAS.md
BILLING_ENABLED=false
# Segredo que você coloca na URL do webhook cadastrado na Cakto (?token=...).
# Gere um valor longo e aleatório, ex.: openssl rand -hex 32
CAKTO_WEBHOOK_TOKEN=
# O webhook grava a assinatura com a chave de serviço do Supabase (somente servidor).
# SUPABASE_SERVICE_ROLE_KEY (definida lá em cima) também é obrigatória para isso.
# Links de checkout das 4 ofertas (preencha quando criar os produtos na Cakto; só https://)
CAKTO_CHECKOUT_URL_PRODUTOR_MENSAL=
CAKTO_CHECKOUT_URL_PRODUTOR_ANUAL=
CAKTO_CHECKOUT_URL_FAZENDA_MENSAL=
CAKTO_CHECKOUT_URL_FAZENDA_ANUAL=
# IDs das 4 ofertas na Cakto, para o webhook saber qual plano foi comprado
CAKTO_OFFER_PRODUTOR_MENSAL=
CAKTO_OFFER_PRODUTOR_ANUAL=
CAKTO_OFFER_FAZENDA_MENSAL=
CAKTO_OFFER_FAZENDA_ANUAL=
# Link da área do cliente na Cakto para gerenciar/cancelar (opcional)
CAKTO_MANAGE_URL=

# --- Limites ------------------------------------------------------------
# Máximo de mensagens por usuário a cada 10 minutos
RATE_LIMIT_MESSAGES_PER_10_MIN=20

# --- WhatsApp (futuro; desligado por padrão) ----------------------------
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
